##################################################
# USER-REGION ASSIGNMENT TESTS
##################################################

### 37. Get all user-region assignments
GET http://localhost:5204/api/admin/userregions
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 38. Get a specific user-region assignment
GET http://localhost:5204/api/admin/userregions/1/1
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 39. Get all regions assigned to a user
GET http://localhost:5204/api/admin/userregions/user/1/regions
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 40. Get all users assigned to a region
GET http://localhost:5204/api/admin/userregions/region/1/users
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 41. Assign a user to a region
POST http://localhost:5204/api/admin/userregions
Authorization: Basic YWRtaW46YWRtaW4xMjM=
Content-Type: application/json

{
  "userId": 1,
  "regionId": 1,
  "metadata": {}
}

### 42. Assign a region to a user (alternative endpoint)
POST http://localhost:5204/api/admin/userregions/user/1/regions
Authorization: Basic YWRtaW46YWRtaW4xMjM=
Content-Type: application/json

{
  "regionId": 1
}

### 43. Assign a user to a region (alternative endpoint)
POST http://localhost:5204/api/admin/userregions/region/1/users
Authorization: Basic YWRtaW46YWRtaW4xMjM=
Content-Type: application/json

{
  "userId": 1
}

### 44. Update user-region assignment metadata
PUT http://localhost:5204/api/admin/userregions/1/1
Authorization: Basic YWRtaW46YWRtaW4xMjM=
Content-Type: application/json

{
  "metadata": {
    "notes": "Updated assignment",
    "priority": "high"
  }
}

### 45. Check if user is assigned to region
GET http://localhost:5204/api/admin/userregions/1/1/exists
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 46. Validate if a user can be assigned to a region (same country validation)
GET http://localhost:5204/api/admin/userregions/1/1/validate
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 46.1. Debug user-region assignment (check all details)
GET http://localhost:5204/api/admin/userregions/1/1/debug
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 46.2. Test simple assignment (minimal validation)
POST http://localhost:5204/api/admin/userregions/1/1/test-assign
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 46.3. Fix database trigger (apply SQL fix for the trigger)
POST http://localhost:5204/api/admin/userregions/fix-database-trigger
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 47. Remove user from region
DELETE http://localhost:5204/api/admin/userregions/1/1
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 48. Remove region from user (alternative endpoint)
DELETE http://localhost:5204/api/admin/userregions/user/1/regions/1
Authorization: Basic YWRtaW46YWRtaW4xMjM=

### 49. Remove user from region (alternative endpoint)
DELETE http://localhost:5204/api/admin/userregions/region/1/users/1
Authorization: Basic YWRtaW46YWRtaW4xMjM=

